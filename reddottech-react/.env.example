# ==============================================================================
# Red Dot Technologies — Environment Configuration
# ==============================================================================

# Server Port
PORT=5000

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:5175

# ------------------------------------------------------------------------------
# MySQL Database Connection (cPanel / Localhost)
# ------------------------------------------------------------------------------
# In cPanel, use your cPanel database credentials:
# e.g. DB_USER=cpaneluser_reddot
# e.g. DB_NAME=cpaneluser_reddottech_db
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=reddottech_db

# ------------------------------------------------------------------------------
# Admin Credentials (Default on first seed)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@reddottech.com.np
ADMIN_PASSWORD=changeme
