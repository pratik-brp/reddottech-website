# ── Client-side (Vite / TanStack Start) ──────────────────────────────
# Base URL for the Red Dot Express API.
# Defaults to same-origin "/api" — in development the Vite dev server
# proxies "/api" to the backend on port 5000. For a separate API host in
# production, set the full origin, e.g. https://api.reddottech.com.np/api
VITE_API_BASE_URL=/api

# When running `vite dev`, override the proxy target for "/api" (default http://localhost:5000)
VITE_DEV_PROXY_TARGET=http://localhost:5000

# ── Backend (Express + SQLite, server/server.js) ─────────────────────
# Port the backend listens on.
PORT=5000

# Comma-separated list of browser origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173

# First-run admin account. Only used to create the initial admin user when
# none exists yet. When ADMIN_PASSWORD is left empty, a random password is
# generated once and printed to the server console on first boot — change it
# afterwards under Admin → Settings → Change Password.
ADMIN_EMAIL=admin@reddottech.com.np
ADMIN_PASSWORD=
