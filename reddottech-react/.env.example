# ====================================================================
# Red Dot Technologies (reddottech.com.np) - Environment Configuration
# ====================================================================

# Node Application Port & Environment
PORT=5000
NODE_ENV=production

# MySQL Database Connection Settings (cPanel / Production / Local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=reddottech_db

# Security & CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=https://reddottech.com.np,https://www.reddottech.com.np,http://localhost:5173,http://localhost:5000

# Session & JWT Secrets
JWT_SECRET=your_super_secret_random_jwt_key_here
SESSION_SECRET=your_super_secret_session_key_here

# SMTP / Email Configuration (For Contact forms & AI lead notifications)
SMTP_HOST=mail.reddottech.com.np
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@reddottech.com.np
SMTP_PASS=your_email_password
SMTP_FROM="Red Dot Technologies <info@reddottech.com.np>"
