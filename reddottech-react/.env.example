# ====================================================================
# Red Dot Technologies (reddottech.com.np) - Environment Configuration
# ====================================================================

# Node Application Port & Environment
PORT=5000
NODE_ENV=production
SITE_URL=https://reddottech.com.np

# MySQL Database Connection Settings (cPanel / Production / Local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=reddottech_db

# Security & CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=https://reddottech.com.np,https://www.reddottech.com.np,http://localhost:5173,http://localhost:5000

# Initial Admin Seeding (Auto-creates admin user if admin table is empty)
ADMIN_EMAIL=admin@reddottech.com.np
ADMIN_PASSWORD=change_this_to_a_strong_password_8_chars_min

# HMAC secret for signing AI course access codes (REQUIRED in production)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_CODE_HMAC_SECRET=generate_a_strong_random_64_hex_char_value_here

